{
  "$description": "Tripami design tokens, the source of truth. W3C Design Tokens format. Color tokens carry their dark-mode value in $extensions.tripami.dark.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas":  { "$value": "#FAFAF7", "$extensions": { "tripami": { "dark": "#0E0F11" } }, "$description": "Screen background (paper)" },
      "surface": { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#17181B" } }, "$description": "Cards, sheets, sticky bars" },
      "sunken":  { "$value": "#F2F1EC", "$extensions": { "tripami": { "dark": "#0A0B0C" } }, "$description": "Section bands, wells, skeletons" },
      "raised":  { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#1F2024" } }, "$description": "Floating search, popovers" }
    },
    "border": {
      "hairline": { "$value": "#E6E4DE", "$extensions": { "tripami": { "dark": "#2A2B30" } } },
      "strong":   { "$value": "#D6D3CB", "$extensions": { "tripami": { "dark": "#3A3B41" } } }
    },
    "text": {
      "primary":   { "$value": "#16171B", "$extensions": { "tripami": { "dark": "#F2F1EC" } } },
      "secondary": { "$value": "#5C5E66", "$extensions": { "tripami": { "dark": "#A6A7AD" } } },
      "tertiary":  { "$value": "#6F7178", "$extensions": { "tripami": { "dark": "#8A8C93" } }, "$description": "Use on canvas/surface only, not on sunken" },
      "onImage":   { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#FFFFFF" } } },
      "inverse":   { "$value": "#FAFAF7", "$extensions": { "tripami": { "dark": "#16171B" } } }
    },
    "action": {
      "primary":        { "$value": "#16171B", "$extensions": { "tripami": { "dark": "#F2F1EC" } }, "$description": "Ink pill. Never use the accent for primary actions" },
      "primaryPressed": { "$value": "#2C2D33", "$extensions": { "tripami": { "dark": "#D9D8D2" } } },
      "primaryText":    { "$value": "#FAFAF7", "$extensions": { "tripami": { "dark": "#16171B" } } }
    },
    "accent": {
      "default":  { "$value": "#0B6B61", "$extensions": { "tripami": { "dark": "#5CC4B4" } }, "$description": "Lagoon. State only: you / now / selected. At most 5% of a screen" },
      "pressed":  { "$value": "#08564E", "$extensions": { "tripami": { "dark": "#7DD3C5" } } },
      "subtle":   { "$value": "#E3F1EE", "$extensions": { "tripami": { "dark": "#12302C" } } },
      "onAccent": { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#0E0F11" } } }
    },
    "member": {
      "$description": "Identifies a traveler. Assigned in join order. White initials pass AA on every hue.",
      "clay":     { "$value": "#B4553A" },
      "marigold": { "$value": "#9A6410" },
      "fern":     { "$value": "#3F7D4E" },
      "sky":      { "$value": "#2F73A8" },
      "iris":     { "$value": "#5160C9" },
      "plum":     { "$value": "#7F4FAE" },
      "rose":     { "$value": "#B2466E" },
      "olive":    { "$value": "#66692B" }
    },
    "status": {
      "positive": { "$value": "#2E7D4F", "$extensions": { "tripami": { "dark": "#6FCF97" } } },
      "caution":  { "$value": "#94600F", "$extensions": { "tripami": { "dark": "#F2B84B" } } },
      "critical": { "$value": "#B42318", "$extensions": { "tripami": { "dark": "#F97066" } } }
    },
    "overlay": {
      "glass": { "$value": "#16171B7A", "$description": "48% ink + 16px background blur, chips/buttons on photos" },
      "dim":   { "$value": "#0E0F115C", "$description": "36% behind sheets" }
    }
  },
  "gradient": {
    "scrim": {
      "$type": "gradient",
      "$value": [
        { "color": "#0E0F1100", "position": 0.4 },
        { "color": "#0E0F119E", "position": 1 }
      ],
      "$description": "Top-to-bottom, under text on photos"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui":    { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Bundled variable font (OFL). Set wght and opsz axes." },
      "diary": { "$value": ["Newsreader", "Georgia", "serif"], "$description": "Bundled variable font (OFL). Diary voice only." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "type": {
    "$type": "typography",
    "display":      { "$value": { "fontFamily": "{font.family.diary}", "fontSize": "34px", "lineHeight": "40px", "fontWeight": 400, "letterSpacing": "-0.4px" } },
    "title1":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "28px", "lineHeight": "34px", "fontWeight": 400, "letterSpacing": "-0.4px" } },
    "diaryHeading": { "$value": { "fontFamily": "{font.family.diary}", "fontSize": "24px", "lineHeight": "30px", "fontWeight": 400, "letterSpacing": "-0.2px" } },
    "title2":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "22px", "lineHeight": "28px", "fontWeight": 500, "letterSpacing": "-0.2px" } },
    "title3":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "18px", "lineHeight": "24px", "fontWeight": 500, "letterSpacing": "-0.1px" } },
    "body":         { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "17px", "lineHeight": "24px", "fontWeight": 400, "letterSpacing": "-0.2px" } },
    "diaryBody":    { "$value": { "fontFamily": "{font.family.diary}", "fontSize": "17px", "lineHeight": "26px", "fontWeight": 400, "letterSpacing": "0px" } },
    "callout":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "15px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "-0.1px" } },
    "subhead":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "14px", "lineHeight": "19px", "fontWeight": 400, "letterSpacing": "-0.1px" } },
    "footnote":     { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "0px" } },
    "eyebrow":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600, "letterSpacing": "0.96px" }, "$description": "Always uppercase" },
    "caption":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "11px", "lineHeight": "13px", "fontWeight": 500, "letterSpacing": "0.1px" } },
    "button":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "17px", "lineHeight": "22px", "fontWeight": 500, "letterSpacing": "-0.2px" } },
    "buttonSmall":  { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "15px", "lineHeight": "20px", "fontWeight": 500, "letterSpacing": "-0.1px" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px", "$description": "Screen side margin" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "6px" },
    "sm": { "$value": "10px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "sheet": { "$value": "28px" },
    "pill": { "$value": "999px" }
  },
  "size": {
    "$type": "dimension",
    "hitTarget": { "$value": "44px" },
    "buttonLarge": { "$value": "52px" },
    "buttonSmall": { "$value": "40px" },
    "chip": { "$value": "36px" },
    "search": { "$value": "56px" },
    "quickAction": { "$value": "56px" },
    "rowMin": { "$value": "56px" },
    "avatar": {
      "xs": { "$value": "24px" },
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "56px" },
      "xl": { "$value": "88px" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "1": { "$value": [
      { "color": "#16171B0A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#16171B0F", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px" }
    ] },
    "2": { "$value": [
      { "color": "#16171B0D", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
      { "color": "#16171B1A", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }
    ] },
    "3": { "$value": [
      { "color": "#16171B24", "offsetX": "0px", "offsetY": "-8px", "blur": "40px", "spread": "0px" }
    ] }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "120ms" },
      "quick": { "$value": "200ms" },
      "standard": { "$value": "320ms" },
      "slow": { "$value": "480ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
