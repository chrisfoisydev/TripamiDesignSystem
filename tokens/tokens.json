{
  "$description": "Tripami design tokens, the source of truth. W3C Design Tokens format. Color tokens carry their dark-mode value in $extensions.tripami.dark.",
  "color": {
    "$type": "color",
    "brand": {
      "navy":   { "$value": "#02203A", "$description": "Logo wordmark. Also text-primary and the ink pill." },
      "orange": { "$value": "#FC6316", "$description": "The dot on the logo's i. Logo and brand moments only: 3.0:1 on white, never text or a UI mark." }
    },
    "bg": {
      "canvas":  { "$value": "#FAFAF7", "$extensions": { "tripami": { "dark": "#0B1220" } }, "$description": "Screen background (paper)" },
      "surface": { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#121A29" } }, "$description": "Cards, sheets, sticky bars" },
      "sunken":  { "$value": "#F2F1EC", "$extensions": { "tripami": { "dark": "#070C16" } }, "$description": "Section bands, wells, skeletons" },
      "raised":  { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#1A2333" } }, "$description": "Floating search, popovers" }
    },
    "border": {
      "hairline": { "$value": "#E6E4DE", "$extensions": { "tripami": { "dark": "#243045" } } },
      "strong":   { "$value": "#D6D3CB", "$extensions": { "tripami": { "dark": "#334058" } } }
    },
    "text": {
      "primary":   { "$value": "#02203A", "$extensions": { "tripami": { "dark": "#F2F1EC" } } },
      "secondary": { "$value": "#525D6E", "$extensions": { "tripami": { "dark": "#A7AFBD" } } },
      "tertiary":  { "$value": "#66707F", "$extensions": { "tripami": { "dark": "#8C95A3" } }, "$description": "Use on canvas/surface only, not on sunken" },
      "onImage":   { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#FFFFFF" } } },
      "inverse":   { "$value": "#FAFAF7", "$extensions": { "tripami": { "dark": "#02203A" } } }
    },
    "action": {
      "primary":        { "$value": "#02203A", "$extensions": { "tripami": { "dark": "#F2F1EC" } }, "$description": "Ink pill. Never use the accent for primary actions" },
      "primaryPressed": { "$value": "#12355A", "$extensions": { "tripami": { "dark": "#D9D8D2" } } },
      "primaryText":    { "$value": "#FAFAF7", "$extensions": { "tripami": { "dark": "#02203A" } } }
    },
    "accent": {
      "default":  { "$value": "#B8400F", "$extensions": { "tripami": { "dark": "#FF7A3D" } }, "$description": "Deep Tripami orange (text-safe). State only: you / now / selected / needs you. At most 5% of a screen" },
      "pressed":  { "$value": "#9A3409", "$extensions": { "tripami": { "dark": "#FF9866" } } },
      "subtle":   { "$value": "#FFF1E8", "$extensions": { "tripami": { "dark": "#3A1D10" } } },
      "onAccent": { "$value": "#FFFFFF", "$extensions": { "tripami": { "dark": "#02203A" } } }
    },
    "member": {
      "$description": "Identifies a traveler. Assigned in join order. White initials pass AA on every hue.",
      "lagoon":   { "$value": "#0B6B61" },
      "sky":      { "$value": "#2F73A8" },
      "iris":     { "$value": "#5160C9" },
      "plum":     { "$value": "#7F4FAE" },
      "rose":     { "$value": "#B2466E" },
      "fern":     { "$value": "#3F7D4E" },
      "olive":    { "$value": "#66692B" },
      "slate":    { "$value": "#4F5D75" }
    },
    "status": {
      "positive": { "$value": "#2E7D4F", "$extensions": { "tripami": { "dark": "#6FCF97" } } },
      "caution":  { "$value": "#7A5A00", "$extensions": { "tripami": { "dark": "#E8C054" } } },
      "critical": { "$value": "#B3133F", "$extensions": { "tripami": { "dark": "#FF6B8A" } } }
    },
    "overlay": {
      "glass": { "$value": "#02203A7A", "$description": "48% navy + 16px background blur, chips/buttons on photos" },
      "dim":   { "$value": "#02203A5C", "$description": "36% behind sheets" }
    }
  },
  "gradient": {
    "scrim": {
      "$type": "gradient",
      "$value": [
        { "color": "#0B122000", "position": 0.4 },
        { "color": "#0B12209E", "position": 1 }
      ],
      "$description": "Top-to-bottom, under text on photos"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui":    { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Bundled variable font (OFL). Set wght and opsz axes." },
      "diary": { "$value": ["Newsreader", "Georgia", "serif"], "$description": "Bundled variable font (OFL). Diary voice only." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "type": {
    "$type": "typography",
    "display":      { "$value": { "fontFamily": "{font.family.diary}", "fontSize": "34px", "lineHeight": "40px", "fontWeight": 400, "letterSpacing": "-0.4px" } },
    "title1":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "28px", "lineHeight": "34px", "fontWeight": 400, "letterSpacing": "-0.4px" } },
    "diaryHeading": { "$value": { "fontFamily": "{font.family.diary}", "fontSize": "24px", "lineHeight": "30px", "fontWeight": 400, "letterSpacing": "-0.2px" } },
    "title2":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "22px", "lineHeight": "28px", "fontWeight": 500, "letterSpacing": "-0.2px" } },
    "title3":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "18px", "lineHeight": "24px", "fontWeight": 500, "letterSpacing": "-0.1px" } },
    "body":         { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "17px", "lineHeight": "24px", "fontWeight": 400, "letterSpacing": "-0.2px" } },
    "diaryBody":    { "$value": { "fontFamily": "{font.family.diary}", "fontSize": "17px", "lineHeight": "26px", "fontWeight": 400, "letterSpacing": "0px" } },
    "callout":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "15px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "-0.1px" } },
    "subhead":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "14px", "lineHeight": "19px", "fontWeight": 400, "letterSpacing": "-0.1px" } },
    "footnote":     { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "0px" } },
    "eyebrow":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600, "letterSpacing": "0.96px" }, "$description": "Always uppercase" },
    "caption":      { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "11px", "lineHeight": "13px", "fontWeight": 500, "letterSpacing": "0.1px" } },
    "button":       { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "17px", "lineHeight": "22px", "fontWeight": 500, "letterSpacing": "-0.2px" } },
    "buttonSmall":  { "$value": { "fontFamily": "{font.family.ui}",    "fontSize": "15px", "lineHeight": "20px", "fontWeight": 500, "letterSpacing": "-0.1px" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px", "$description": "Screen side margin" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "6px" },
    "sm": { "$value": "10px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "sheet": { "$value": "28px" },
    "pill": { "$value": "999px" }
  },
  "size": {
    "$type": "dimension",
    "hitTarget": { "$value": "44px" },
    "buttonLarge": { "$value": "52px" },
    "buttonSmall": { "$value": "40px" },
    "chip": { "$value": "36px" },
    "search": { "$value": "56px" },
    "quickAction": { "$value": "56px" },
    "rowMin": { "$value": "56px" },
    "avatar": {
      "xs": { "$value": "24px" },
      "sm": { "$value": "32px" },
      "md": { "$value": "40px" },
      "lg": { "$value": "56px" },
      "xl": { "$value": "88px" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "1": { "$value": [
      { "color": "#02203A0A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#02203A0F", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px" }
    ] },
    "2": { "$value": [
      { "color": "#02203A0D", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
      { "color": "#02203A1A", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }
    ] },
    "3": { "$value": [
      { "color": "#02203A24", "offsetX": "0px", "offsetY": "-8px", "blur": "40px", "spread": "0px" }
    ] }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "120ms" },
      "quick": { "$value": "200ms" },
      "standard": { "$value": "320ms" },
      "slow": { "$value": "480ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
